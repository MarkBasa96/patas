{
  "name": "patas",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --import ./test/ts-resolve.mjs --test test/*.test.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "export:web": "node scripts/copy-wasm.mjs && expo export -p web --clear --output-dir dist",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "opentype.js": "^1.3.4",
    "typescript": "~6.0.3"
  }
}
